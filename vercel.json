{
  "version": 2,
  "installCommand": "npm ci && npm ci --prefix server && npm ci --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/:match*", "destination": "/api/index.js" },
    { "source": "/uploads/:match*", "destination": "/api/index.js" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ]
}
