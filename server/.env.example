# ─── Core (required) ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ennigma
# Required. Use a long random value, e.g. `openssl rand -hex 32` (min 32 chars in production)
JWT_SECRET=
# Public URL of the storefront (used for CORS and payment return URLs)
FRONTEND_URL=http://localhost:5173
# Public URL of this API if it differs from FRONTEND_URL (used for PayHere notify_url)
# API_PUBLIC_URL=https://your-domain.com

# ─── Pricing ─────────────────────────────────────────────────────
STORE_CURRENCY=LKR
FREE_SHIPPING_THRESHOLD=150
FLAT_SHIPPING_RATE=15

# ─── Stripe (card payments via Stripe Checkout) ──────────────────
# Leave empty to disable card payments. Test keys (sk_test_) work too.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/payments/webhook
# (listen for checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# ─── PayHere ─────────────────────────────────────────────────────
# Leave empty to disable PayHere.
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_SANDBOX=true

# ─── Image / receipt storage ─────────────────────────────────────
# Strongly recommended in production. Without it, files are stored in MongoDB.
CLOUDINARY_URL=
# or:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=ENNIGMA PARIS
EMAIL_FROM_ADDRESS=

# ─── Order alerts ────────────────────────────────────────────────
OWNER_EMAIL=
OWNER_WHATSAPP=
MANAGER_EMAIL=
MANAGER_WHATSAPP=
# One of: twilio | ultramsg | greenapi | wassenger | callmebot
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
WASSENGER_API_KEY=
CALLMEBOT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Scripts only ────────────────────────────────────────────────
# Used by `npm run reset-db` to create the first admin account
ADMIN_EMAIL=admin@ennigmaparis.com
ADMIN_PASSWORD=
