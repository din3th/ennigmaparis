{
  "name": "ennigma-root",
  "version": "1.0.0",
  "type": "module",
  "description": "Root project to run client and server concurrently",
  "scripts": {
    "build": "npm run build --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "concurrently \"npm start --prefix server\" \"npm start --prefix client\"",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
